# Sentry error monitoring — leave EMPTY locally.
# Get your DSN from the project's Sentry settings, under Client Keys (DSN).
# Deployed builds must inject a real DSN: an empty or placeholder value disables
# error telemetry entirely, and the build logs one error saying so (see A-11).
VITE_SENTRY_DSN=

# ── Backend ────────────────────────────────────────────────────────────────
# GoMingle API (the gomingle-api project). The Admin Panel lives under /admin.
VITE_API_BASE_URL=http://localhost:4000/admin

# "false" = call VITE_API_BASE_URL (the backend). "true" = frontend-only demo on
# Mock Service Worker (no backend needed).
VITE_MSW_ENABLED=false
# With mocks on: unset/"full" mocks everything; "hybrid" mocks only the modules
# with no backend yet and sends the rest to VITE_API_BASE_URL.
VITE_MSW_MODE=

# ── Sign-in ───────────────────────────────────────────────────────────────
# "api" = the GoMingle backend's own JWT login; "cognito" = AWS Cognito.
# Unset: Cognito when both values below are set, otherwise the backend.
VITE_AUTH_MODE=api
VITE_AWS_REGION=
VITE_COGNITO_CLIENT_ID=
# Show the demo account on the sign-in screen (admin@gomingle.com / Admin@123).
VITE_SHOW_DEMO_CREDENTIALS=true

# /open-app deep-link redirect (MET-1203).
# Custom scheme the mobile app registers — used to build gomingle://{type}/{id}.
VITE_APP_DEEP_LINK_SCHEME=gomingle
# Numeric App Store ID (digits only, no "id" prefix) — from App Store Connect.
# Leave empty until the app is listed; iOS then falls back to VITE_WEB_FALLBACK_URL.
VITE_IOS_APP_ID=
# Android application ID, e.g. com.gomingle.app — from the app's build.gradle.
# Leave empty until the app is listed; Android then falls back to VITE_WEB_FALLBACK_URL.
VITE_ANDROID_PACKAGE_NAME=
# Where desktop visitors (and unconfigured platforms) are sent.
VITE_WEB_FALLBACK_URL=https://gomingle.com