# Vite loads .env (mode-agnostic) even for `vitest` runs (mode=test), so the
# local .env's VITE_MSW_ENABLED=false — which is meant to control `npm run dev`
# against a real backend — would otherwise leak into the test suite and make
# httpClient try to hit the real API instead of MSW. This mode-specific file
# takes priority over .env for `vitest` and keeps mocks on for tests.
VITE_MSW_ENABLED=true
VITE_AUTH_MODE=cognito
