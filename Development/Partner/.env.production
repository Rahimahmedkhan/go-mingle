# Loaded by `vite build` (dev and qa both deploy a production build), so
# anything set here ships to a real environment.
#
# This MUST stay false. It read `true` while the app was a UI-only prototype
# with no backend, which meant every deployed build started the Mock Service
# Worker and answered its own API calls — signup and login appeared to work
# while never leaving the browser.
#
# Values: true = everything mocked · legacy = only the unversioned prototype
# endpoints · false = no mocks. To mock a single environment temporarily, set a
# VITE_ENABLE_MOCKS repository variable instead — real environment variables
# take precedence over this file, so no commit is needed.
VITE_ENABLE_MOCKS=false
