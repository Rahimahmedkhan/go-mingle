# Sentry error monitoring.
# Get your DSN from https://sentry.io/settings/<org>/projects/<project>/keys/
# Leave blank to run with Sentry uninstalled entirely (no global handlers, no
# breadcrumb recording). Reporting is PROD-only regardless of this value.
VITE_SENTRY_DSN=

# Tags every Sentry issue with the release that produced it, as
# `gomingle-partner-web@<version>`. Set it in CI to the build or commit id so an
# issue can be traced to a deploy; defaults to 1.0.0 when unset.
VITE_APP_VERSION=

# GoMingle API (the gomingle-api project). The Partner Portal lives under /partner.
# In dev this becomes the Vite proxy target for /api.
VITE_API_BASE_URL=http://localhost:4000/partner

# Mock Service Worker. Unset = on in dev, off in a production build.
#   true    all endpoints mocked
#   legacy  only the unversioned prototype endpoints are mocked; /api/v1/partner/*
#           goes to the real backend. Use this while F1/J1 are live but the
#           prototype screens (J3/J4/J5/J6x) have no backend yet.
#   false   no mocks at all
VITE_ENABLE_MOCKS=false

# GoMingle-Partners Cognito pool (Partner Portal F1).
# Login is frontend-direct to Cognito — the refresh token never reaches our API.
# Leave BOTH blank to run against the mock auth provider + MSW.
# The app client must have USER_SRP_AUTH and REFRESH_TOKEN_AUTH enabled,
# with a 2h access token and a 7d refresh token (BR-01).
VITE_COGNITO_PARTNERS_POOL_ID=
VITE_COGNITO_PARTNERS_CLIENT_ID=
# "api" = the GoMingle backend's own JWT login (use with VITE_ENABLE_MOCKS=false),
# "mock" = offline demo provider, "cognito" = the pool above.
# Unset: Cognito when the pool is configured, otherwise the mock provider.
VITE_AUTH_MODE=api
# Show the demo account on the sign-in screen (partner@gomingle.com / Partner@123).
VITE_SHOW_DEMO_CREDENTIALS=true
VITE_COGNITO_REGION=me-central-1

# Google Places autocomplete on the restaurant address field
VITE_GOOGLE_MAPS_API_KEY=
